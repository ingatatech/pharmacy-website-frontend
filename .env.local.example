NEXT_PUBLIC_API_URL=http://localhost:4000

# Powers the language switcher's live translation (English -> Kinyarwanda).
# Get a free key at https://console.groq.com/keys — never prefix this with
# NEXT_PUBLIC_, it's read only inside the server-side /api/translate route
# and must never reach the browser.
GROQ_API_KEY=

# Optional — defaults to openai/gpt-oss-120b if unset. See
# https://console.groq.com/docs/models for the full, changing model list.
GROQ_MODEL=
