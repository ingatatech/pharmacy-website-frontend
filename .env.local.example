NEXT_PUBLIC_API_URL=http://localhost:4000

# The site's own public URL — used for the sitemap, robots.txt,
# canonical/OG metadata and structured data. Defaults to localhost if
# unset, but production MUST set this to the real domain once one exists.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — leave blank until there's a real Google Analytics 4 property
# to point at. When set, analytics only loads for visitors who accept the
# cookie consent banner (see CookieConsentBanner.tsx / Analytics.tsx).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Powers the language switcher's live translation (English -> Kinyarwanda).
# Get a free key at https://console.groq.com/keys — never prefix this with
# NEXT_PUBLIC_, it's read only inside the server-side /api/translate route
# and must never reach the browser.
GROQ_API_KEY=

# Optional — defaults to openai/gpt-oss-120b if unset. See
# https://console.groq.com/docs/models for the full, changing model list.
GROQ_MODEL=
